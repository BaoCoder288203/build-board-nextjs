# Public client env (safe to commit as example). Copy to .env.local for local next dev.

NEXT_PUBLIC_API_URL=http://localhost:4000/api/v1
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_APP_NAME=BuildBoard
NEXT_PUBLIC_SOCKET_URL=

# Optional FE fallback ICE servers (JSON RTCIceServer[]).
# Prefer BE GET /meetings/ice-servers (TURN secrets stay on server).
# NEXT_PUBLIC_WEBRTC_ICE_SERVERS=[{"urls":"stun:stun.l.google.com:19302"}]
